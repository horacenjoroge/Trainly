# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://mongodb:27017/trainly

# JWT
JWT_SECRET=your-jwt-secret-here-change-in-production
REFRESH_TOKEN_SECRET=your-refresh-secret-here-change-in-production

# Twilio (optional for SOS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Redis (optional)
REDIS_URL=

# Storage (local or s3)
STORAGE_TYPE=local

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
SOS_RATE_LIMIT_MAX=5

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
